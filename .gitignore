# Generated by Cargo
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# IDE & Editor
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python & virtual environments (pipelines)
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/
.ruff_cache/

# Local Environment Variables
.env
.env.local

# Training & Corpus Data (downloaded and generated by scripts - avoid redistribution)
/data/*
!/data/.gitkeep
/data/raw/
/data/corpus/
crates/oniwa-lm/data/*
!crates/oniwa-lm/data/.gitkeep

# Model weights binaries (large generated artifacts)
**/checkpoints/**/weights.bin
checkpoints/**/weights.bin
crates/oniwa-lm/checkpoints/**/weights.bin

# Detailed step-by-step training logs (keep root growth_journal.md and ledger)
/logs/runs/
**/logs/runs/**

